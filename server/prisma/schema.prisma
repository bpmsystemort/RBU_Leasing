generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Portal self-signups (lessor/lessee) start PENDING and need an ADMIN or
// LEASING_OFFICER to approve them before they can sign in. Staff accounts
// created from the Users screen are APPROVED outright.
enum AccountStatus {
  PENDING
  FOR_REVISION
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  LEASING_OFFICER
  VIEWER
  UNIT_OWNER
  TENANT
}

enum UnitApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InquiryCategory {
  RESIDENCES
  OFFICES
}

enum InquirerType {
  LESSOR
  LESSEE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
  CONVERTED
}

enum InfoSheetStatus {
  REQUESTED
  SUBMITTED
  APPROVED
  RETURNED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  passwordPlain String?   // recoverable copy for the admin credential list (internal tool)
  role         Role       @default(VIEWER)
  // Defaults to APPROVED so existing accounts and admin-created staff logins
  // are unaffected; only the signup route sets PENDING.
  status       AccountStatus @default(APPROVED)
  // `email` doubles as the login username and may not be an address at all, so
  // the reachable address given at signup is kept separately — the approver
  // needs a way to contact the applicant.
  contactEmail String?
  // Approver is stored by id + name rather than as a relation: a self-relation
  // on User complicates every query here, and the name must survive the
  // approver's account being deleted.
  approvedById   String?
  approvedByName String?
  decidedAt      DateTime?
  rejectionReason String?
  // The unit a lessor described while applying, held until approval — see
  // manual-migrations/2026-09-10-user-pending-unit.sql. Whitelisted keys only:
  // estateId, towerId, unitNumber, floor, slotNo, type, baseRent.
  pendingUnit  Json?
  unitOwner    UnitOwner? @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId  String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId     String?
  assignedInquiries Inquiry[] @relation("InquiryAssignee")
  convertedInquiries Inquiry[] @relation("InquiryConversion")
  assignedOwners UnitOwner[] @relation("OwnerOfficer")
  assignedTransactions LeasingTransaction[] @relation("TxnOfficer")
  pageFormEntries PageFormEntry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

model UnitOwner {
  id         String                @id @default(cuid())
  name       String
  nameKey    String?
  email      String?
  phone      String?
  address    String?
  assignedOfficer   User?          @relation("OwnerOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  assignedOfficerId String?
  needsReview Boolean               @default(false)
  units      Unit[]
  users      User[]
  lessorInfoSheets LessorInfoSheet[]
  leasingTransactions LeasingTransaction[]
  lessorRequirements LessorRequirement[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([nameKey])
}

model LessorInfoSheet {
  id          String          @id @default(cuid())
  unitOwner   UnitOwner       @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  filledPdf   Bytes? // the interactive PDF the lessor filled and submitted
  remarks     String?
  submittedByName String?
  reviewedByName  String?
  formVersion     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LesseeInfoSheet {
  id          String          @id @default(cuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  filledPdf   Bytes? // the interactive PDF the lessee filled and submitted
  remarks     String?
  submittedByName String?
  reviewedByName  String?
  formVersion     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Estate {
  id        String   @id @default(cuid())
  name      String   @unique
  towers    Tower[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tower {
  id        String   @id @default(cuid())
  name      String
  estate    Estate   @relation(fields: [estateId], references: [id])
  estateId  String
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([estateId, name])
}

model Unit {
  id         String     @id @default(cuid())
  owner      UnitOwner  @relation(fields: [ownerId], references: [id])
  ownerId    String
  unitNumber String
  unitKey    String?
  building   String?
  tower      Tower?     @relation(fields: [towerId], references: [id])
  towerId    String?
  floor      String?
  slotNo     String?
  type       String     @default("OTHER")
  sizeSqm    Decimal?
  baseRent   Decimal
  status     UnitStatus @default(VACANT)
  approvalStatus UnitApprovalStatus @default(APPROVED)
  reviewRemarks  String?
  needsStatusReview Boolean @default(false)
  leases     Lease[]
  leasingTransactions LeasingTransaction[]
  inquiries           Inquiry[]
  photos     UnitPhoto[]
  listing    UnitListing?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([ownerId, unitKey])
}

model UnitPhoto {
  id            String   @id @default(cuid())
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId        String
  data          Bytes
  mimeType      String
  size          Int
  caption       String?
  sortOrder     Int      @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([unitId])
}

model UnitListing {
  id            String    @id @default(cuid())
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId        String    @unique
  published     Boolean   @default(false)
  publishedAt   DateTime?
  headline      String?
  details       Json      @default("{}")
  visibleFields Json      @default("[]")
  coverPhotoId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  nameKey      String?
  email        String?
  phone        String?
  address      String?
  leases       Lease[]
  users        User[]
  requirements Requirement[]
  lesseeInfoSheets LesseeInfoSheet[]
  leasingTransactions LeasingTransaction[]
  lesseeRequirements LesseeRequirement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([nameKey])
}

// Admin-built forms (CMS). `fields` is a JSON array of field definitions
// ({ key, label, type, required, placeholder, options }) matching the shape the
// client ConfigurableForm renders.
model CmsForm {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  fields      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A custom field set the Super Admin attaches to one (role, page) navigation
// slot — e.g. the Lessee's "Acceptance Form" page. `fields` uses the same JSON
// shape as CmsForm. Users of that role see these fields on that page and their
// answers are stored as PageFormEntry rows.
model PageForm {
  id        String          @id @default(cuid())
  role      Role
  pageKey   String
  title     String?
  fields    Json            @default("[]")
  entries   PageFormEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([role, pageKey])
}

// One user's saved answers to a PageForm (one row per user per form; upserted).
model PageFormEntry {
  id         String   @id @default(cuid())
  pageForm   PageForm @relation(fields: [pageFormId], references: [id], onDelete: Cascade)
  pageFormId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pageFormId, userId])
}

model Requirement {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now())
}

model LessorRequirement {
  id             String    @id @default(cuid())
  unitOwner      UnitOwner @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId    String
  requirementKey String
  status         String    @default("Required")
  filename       String?
  mimeType       String?
  size           Int?
  data           Bytes?
  remarks        String?
  expiresAt      DateTime?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([unitOwnerId, requirementKey])
}

model Lease {
  id          String      @id @default(cuid())
  unit        Unit        @relation(fields: [unitId], references: [id])
  unitId      String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Decimal
  deposit     Decimal     @default(0)
  status      LeaseStatus @default(ACTIVE)
  advanceRent     String?
  securityDeposit String?
  modeOfPayment   String?
  serviceFee      String?
  source          String?
  renewalPeriod   String?
  remarks         String?
  managedBy       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([unitId, tenantId, startDate, endDate])
}

model Inquiry {
  id           String          @id @default(cuid())
  category     InquiryCategory
  inquirerType InquirerType
  inquiryType  String
  fullName     String
  email        String
  message      String?
  consent      Boolean
  status       InquiryStatus   @default(NEW)
  assignedTo   User?           @relation("InquiryAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  convertedUser   User?        @relation("InquiryConversion", fields: [convertedUserId], references: [id])
  convertedUserId String?
  leasingTransaction LeasingTransaction?
  unit         Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// The single source of truth for one end-to-end leasing transaction. Progresses
// through the stages defined in shared/leasingStages.js; `stage`/`status`/
// `finalStatus` are validated against that registry (kept as strings, not PG
// enums, so the many per-stage statuses stay flexible under manual migrations).
model LeasingTransaction {
  id          String   @id @default(cuid())
  reference   String   @unique // RBU-YYYY-NNNNNN
  stage       String   // current stage key
  status      String   // current status within the stage
  finalStatus String?  // set once the transaction reaches the Status stage
  stageData   Json     @default("{}") // per-stage { status, remarks, completedAt, startedAt }
  lesseeName  String?  // denormalised from the inquiry for quick display

  inquiry     Inquiry?   @relation(fields: [inquiryId], references: [id])
  inquiryId   String?    @unique
  unit        Unit?      @relation(fields: [unitId], references: [id])
  unitId      String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId    String?
  unitOwner   UnitOwner? @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId String?
  assignedOfficer   User? @relation("TxnOfficer", fields: [assignedOfficerId], references: [id])
  assignedOfficerId String?

  events      TransactionEvent[]
  documents   TransactionDocument[]
  approvalSteps ApprovalStep[]
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Supporting documents uploaded against a transaction (e.g. the lessee's
// Approval-stage requirements). Binary held in `data`, like Requirement.
model TransactionDocument {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  filename      String
  mimeType      String
  size          Int
  data          Bytes
  stage         String?  // stage the document was uploaded under
  docType       String?  // LETTER_OF_INTENT | SIGNED_CONTRACT; null = loose supporting document
  uploadedById  String?
  uploadedByName String?
  createdAt     DateTime @default(now())

  @@unique([transactionId, docType])
  @@index([transactionId])
}

// One step of a transaction's sequential approval routing chain
// (Leasing → Management → Authorized Approver → Final Approval).
model ApprovalStep {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  order         Int
  name          String
  status        String   @default("Pending") // Pending / Approved / Rejected / Returned
  approverId    String?
  approverName  String?
  remarks       String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([transactionId, order])
  @@index([transactionId])
}

// Append-only activity log for a transaction (who did what, when).
model TransactionEvent {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  actorId       String?
  actorName     String?
  actorRole     String?
  stage         String?
  message       String
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

// A scheduled visit for a transaction's Inspection / Photoshoot stage.
// One row per (transaction, stage); reschedule edits it in place.
model Appointment {
  id              String   @id @default(cuid())
  transaction     LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId   String
  stage           String
  status          String   @default("Scheduled")
  scheduledAt     DateTime
  location        String?
  notes           String?
  outcome         String?
  reason          String?
  rescheduleCount Int      @default(0)
  // Officer↔lessor viewing handshake: who made the current proposal
  // (LEASING_OFFICER/ADMIN vs UNIT_OWNER) and when the other side confirmed.
  proposedByRole String?
  confirmedAt    DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([transactionId, stage])
  @@index([transactionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The lessee's side of the document checklist — the mirror of
// LessorRequirement. One row per tenant per document type; the row is created
// on first upload and the checklist is completed from the shared config, so an
// untouched type simply reads as Required.
model LesseeRequirement {
  id             String    @id @default(cuid())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  requirementKey String
  status         String    @default("Required")
  filename       String?
  mimeType       String?
  size           Int?
  data           Bytes?
  remarks        String?
  expiresAt      DateTime?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, requirementKey])
}
